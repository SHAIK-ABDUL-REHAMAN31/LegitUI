# ════════════════════════════════════════════════════
# LegitUI — .gitignore
# ════════════════════════════════════════════════════

# ──── Dependencies ────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ──── Next.js build output ────
/.next/
/out/
/build/

# ──── Generated files (rebuilt on every build) ────
/public/registry/
*.tsbuildinfo
next-env.d.ts

# ──── Environment variables ────
.env
.env.*
!.env.example

# ──── OS-specific ────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ──── IDE / Editor ────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ──── Debug logs ────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ──── Testing & Coverage ────
/coverage/

# ──── Vercel ────
.vercel/

# ──── Package manager lock files (keep package-lock.json) ────
yarn.lock
pnpm-lock.yaml

# ──── Preview recording temp frames ────
.tmp-frames/

# ──── Certificates ────
*.pem
